model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String
  phone    String

  addressLine String
  city        String
  state       String
  pincode     String
  country     String @default("India")

  isDefault Boolean @default(false)
}
